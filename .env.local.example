# Copy to .env.local and fill in. Never commit .env.local.
# Full setup guide: docs/SETUP.md

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API (or the output of `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: used by /api/complete-onboarding and the demo
# scripts. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────────
# Server-only. Used by /api/responses/generate.
ANTHROPIC_API_KEY=

# ── Public demo account ─────────────────────────────────────────────────────
# Server-only. Created/reset by `npm run db:seed`. The values below match the
# local seed (supabase/seed.sql); use a long random password in production.
DEMO_USER_EMAIL=demo@ansai.local
DEMO_USER_PASSWORD=ansai-demo-local
