# Copy to .env.local and fill in. Never commit .env.local.
# Full setup guide: docs/SETUP.md

# ── Site ────────────────────────────────────────────────────────────────────
# Public base URL, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API (or the output of `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: used by /api/complete-onboarding and the demo
# scripts. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────────
# Server-only. Used by /api/responses/generate.
ANTHROPIC_API_KEY=

# ── Public demo account ─────────────────────────────────────────────────────
# Server-only. Created/reset by `npm run db:seed`. The values below match the
# local seed (supabase/seed.sql); use a long random password in production.
# Visitors never type these: /api/demo/login signs them in server-side.
DEMO_USER_EMAIL=demo@ansai.local
DEMO_USER_PASSWORD=ansai-demo-local
# Max AI generations per rolling 24h across ALL demo visitors (default 20).
AI_DEMO_DAILY_LIMIT=20

# ── AI ──────────────────────────────────────────────────────────────────────
# Models: complex reviews (≤2★ or >400 chars) use the first, the rest the second.
ANTHROPIC_MODEL_COMPLEX=claude-opus-4-7
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5
# Per-user AI generation limits (the demo also has AI_DEMO_DAILY_LIMIT above).
AI_USER_MINUTE_LIMIT=5
AI_USER_DAILY_LIMIT=100

# ── Bot protection (Cloudflare Turnstile) ───────────────────────────────────
# Public site key. Leave empty to hide the widget (only if CAPTCHA is also
# disabled in Supabase Auth). Cloudflare test key that always passes:
# 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
